{
	"name": "waymarq",
	"version": "0.0.1",
	"description": "One-tap roadside mapping for OSM",
	"license": "AGPL-3.0-or-later",
	"author": "Alen Šiljak",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"deploy": "npm run build && wrangler deploy"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"prettier": "^3.0.0",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "^6.0.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"wrangler": "^4.155.0"
	},
	"dependencies": {
		"maplibre-gl": "^6.16.0"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"workerd@1.20261023.1": true
	}
}
